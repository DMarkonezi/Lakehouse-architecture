# Lokalne lozinke za demo okruzenje. reset.ps1 kopira ovaj fajl u .env ako .env ne postoji.

# MinIO administrator (samo za konzolu na http://localhost:9001 i za kreiranje korisnika)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=lakehouse-admin-2026

# S3 korisnici sa najmanjim privilegijama (kreira ih minio/setup.sh)
CATALOG_S3_ACCESS_KEY=catalog
CATALOG_S3_SECRET_KEY=catalog-secret-2026
SPARK_S3_ACCESS_KEY=spark
SPARK_S3_SECRET_KEY=spark-secret-2026
EXPLORER_S3_ACCESS_KEY=explorer
EXPLORER_S3_SECRET_KEY=explorer-secret-2026
# Trino i konzola smeju samo da citaju
TRINO_S3_ACCESS_KEY=trino
TRINO_S3_SECRET_KEY=trino-readonly-2026

# Izvorna OLTP baza
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop-secret-2026
POSTGRES_DB=shop
# Spark cita izvornu bazu korisnikom koji sme samo SELECT (pravi ga sources/postgres/reader.sh)
LAKE_READER_USER=lake_reader
LAKE_READER_PASSWORD=reader-secret-2026
